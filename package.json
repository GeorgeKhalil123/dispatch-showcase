    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.12.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
